{% comment %}
This page represents the /collections and /products pages.
It is an optional, but highly recommended, template for your theme.

More info:
- http://docs.shopify.com/manual/configuration/store-customization/taking-control-of-collections-listing
{% endcomment %} 
{{ 'sidebar.css' | asset_url | stylesheet_tag }}
{%- if settings.sidebar_move == blank -%}
{% include 'breadcrumb' %}
{%- endif -%} 
{%- assign sidebar-left = section.settings.sidebar_left -%}
{%- assign sidebar-right = section.settings.sidebar_right -%} 
{%- assign sidebar_style = section.settings.sidebar_style -%}
<div class="collection-main">
  <div class="container">
    <div class="row"> 
      {%- assign sidebar_class = 'col-lg-3' -%}
      {%- if sidebar-left != blank -%}
      {%- assign main_class = 'col-lg-9' -%}
      {%- endif -%} 
      {%- if sidebar-right != blank -%}
      {%- assign main_class = 'col-lg-9' -%} 
      {%- endif -%}
      {%- if sidebar-left != blank and sidebar-right != blank -%}
      {%- assign main_class = 'col-lg-6' -%} 
      {%- endif -%}   
      {%- if sidebar-left == blank and sidebar-right == blank -%}
      {%- assign main_class = 'col-lg-12' -%} 
      {%- endif -%}  
      <div class="{{main_class}} collection-content order-1">
        <div class="category-products item-1200-4 item-992-3 item-768-2 item-640-2 item-320-1 short-collection-list show-count-on-{{section.settings.product_count}} category-pos-{{section.settings.content_position}} category-text-{{section.settings.content_text_align}} category-color-{{section.settings.content_color}} overlay-bg-{{section.settings.overlay_bg_opacity}}">
          {%- if settings.sidebar_move != blank -%}
          {% include 'breadcrumb' %}
          {%- endif -%}
          <ul id="products-grid" class="products-grid collection-spacing-{{section.settings.item_margin}}">
            {% for sub_collection in collections %}
            {% if sub_collection.handle != 'frontpage' and sub_collection.all_products_count > 0 %}
            <li class="item product pt-0 pb-0 product-layout-grid{% if section.settings.box_shadow != blank %} shadow{% endif %}">
              {% include 'collection-grid-item' %}
            </li>
            {% endif %}
            {% endfor %}
          </ul>
        </div>
        <style> 
          .short-collection-list.overlay-bg-{{section.settings.overlay_bg_opacity}} .item .thumb-info-wrapper:after {
            background-color: rgba(27, 27, 23, {{section.settings.overlay_bg_opacity | plus: 0 | times: 1.0 | divided_by: 100}});
          }
          .short-collection-list.overlay-bg-{{section.settings.overlay_bg_opacity}} .item:hover .thumb-info-wrapper:after {
            background-color: rgba(27, 27, 23, {{section.settings.overlay_hover_bg_opacity | plus: 0 | times: 1.0 | divided_by: 100}});
          }
          {%- assign _color_hover = settings.theme_color -%}
          {%- case section.settings.content_hover_color -%}
          {%- when 'light' -%}
          {%- assign _color_hover = '#fff' -%}
          {%- when 'dark' -%}
          {%- assign _color_hover = '#1d2127' -%} 
          {%- endcase-%} 
        </style>
      </div>
      {% if sidebar-left != blank %}
      <div class="{{sidebar_class}} sidebar col-left">
        {% include 'sidebar-left', sidebar_style: sidebar_style %}
      </div>
      {% endif %}
      {% if sidebar-right != blank %}
      <div class="{{sidebar_class}} sidebar-right col-right order-2">
        {% include 'sidebar-right' %}
      </div>
      {% endif %}
    </div>
  </div>
</div>
